{
  "name": "dsh-anywhere-zcode",
  "version": "1.1.0",
  "description": "DSH 手机访问 + ZCode 手机远程页二合一：多设备同时在线无缝切换、实时同屏收发、锁屏秒级自愈（Fast-Resume），3083 端口统一主控；内置 zcode-rc 网关，把 ZCode 桌面端远程页反代到局域网，iOS 16.3 起可正常打开。包名 dsh-anywhere-zcode 为独有命名，与 npm 上任何同名/近名包无关。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "zcode-rc": "./zcode-rc/install.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "zcode-rc",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "node client/build.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushQAQ/dsh-anywhere-zcode.git"
  },
  "homepage": "https://github.com/liushQAQ/dsh-anywhere-zcode#readme",
  "bugs": {
    "url": "https://github.com/liushQAQ/dsh-anywhere-zcode/issues"
  },
  "author": "liushQAQ",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "remote",
    "qr",
    "tunnel",
    "zcode",
    "zcode-remote",
    "dsh-anywhere-zcode"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-session-log-export"
      ],
      "platform": "web"
    }
  }
}
